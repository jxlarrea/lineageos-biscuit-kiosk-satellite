--- a/frameworks/native/services/surfaceflinger/DisplayHardware/HWComposer_hwc1.cpp
+++ b/frameworks/native/services/surfaceflinger/DisplayHardware/HWComposer_hwc1.cpp
@@ -63,0 +64,6 @@
+static bool isHeadlessNoGpu() {
+    char value[PROPERTY_VALUE_MAX];
+    property_get("ro.config.no_gpu", value, "false");
+    return !strcmp(value, "1") || !strcmp(value, "true");
+}
+
@@ -130 +136,3 @@
-    // If we have no HWC, or a pre-1.1 HWC, an FB dev is mandatory.
+    const bool headlessNoGpu = isHeadlessNoGpu();
+
+    // If we have no HWC, or a pre-1.1 HWC, an FB dev is normally mandatory.
@@ -133,3 +141,6 @@
-        ALOGE("ERROR: failed to open framebuffer (%s), aborting",
