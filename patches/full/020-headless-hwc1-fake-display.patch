+        }
+        ALOGW("No framebuffer; using Biscuit headless fake primary display");
@@ -191,0 +203,15 @@
+    } else if (headlessNoGpu) {
+        DisplayData& disp(mDisplayData[HWC_DISPLAY_PRIMARY]);
+        disp.connected = true;
+        disp.format = HAL_PIXEL_FORMAT_RGBA_8888;
+        DisplayConfig config = DisplayConfig();
+        config.width = 1;
+        config.height = 1;
+        config.xdpi = ACONFIGURATION_DENSITY_TV;
+        config.ydpi = ACONFIGURATION_DENSITY_TV;
+        // Nothing is ever shown: one frame a second keeps anything still
