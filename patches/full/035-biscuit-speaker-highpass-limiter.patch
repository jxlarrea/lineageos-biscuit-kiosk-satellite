+/*
+ * Speaker tuning. Fire OS shapes the signal for the small driver in Amazon's
+ * audio processor, which never starts on this build, so the speaker got the
+ * full range at full level. A high-pass filter removes the bass the driver
+ * cannot reproduce. persist.biscuit.spk_hpf_hz sets the cutoff (0 turns it
+ * off).
+ *
+ * A peak limiter is there too, but off unless persist.biscuit.spk_limiter is
+ * 1. It reduces distortion at high volume, but its gain changes faster than
+ * Kiosk Satellite's echo canceller can follow, and the wake word was nearly
+ * impossible to hear over music at 75% volume and up. The filter is linear,
+ * so the canceller learns it like the rest of the echo path.
+ *
+ * Both are read again whenever playback resumes from standby.
+ */
+#define SPK_MAX_CHANNELS 2
+#define SPK_HPF_SECTIONS 2
+#define SPK_DEFAULT_HPF_HZ 200
+#define SPK_LIMIT_CEILING 0.891f /* -1 dBFS */
+#define SPK_LIMIT_RELEASE_MS 100.0f
+
+struct biquad {
+    float b0, b1, b2, a1, a2;
+    float z1[SPK_MAX_CHANNELS];
+    float z2[SPK_MAX_CHANNELS];
+};
+
+struct speaker_tuning {
+    bool hpf;
+    bool limiter;
+    struct biquad sections[SPK_HPF_SECTIONS];
+    float gain;
+    float release;
+    int16_t* scratch;
+    size_t scratch_bytes;
+};
+
