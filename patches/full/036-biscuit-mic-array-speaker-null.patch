+static ssize_t in_read(struct audio_stream_in* stream, void* buffer, size_t bytes) {
+    struct wrapper_stream_in* in = wrap_in(stream);
+
+    if (in->beam_capable && !in->beam && !in->beam_off) {
+        if (property_get_bool("persist.biscuit.mic_beam", true)) {
+            if (!in->adev->vendor_capture_ready) {
+                /*
+                 * The Fire OS HAL applies its mixer defaults, the microphone
+                 * inputs and preamp among them, when it first opens a stream.
+                 * Until then the ADCs deliver silence, so it opens the
+                 * microphones once, for one buffer, before the array is read.
+                 */
+                in->amazon_stream->read(in->amazon_stream, buffer, bytes);
+                in->amazon_stream->common.standby(&in->amazon_stream->common);
+                in->adev->vendor_capture_ready = true;
+            }
+            in->beam = mic_beam_open(in->adev->beam_model);
+            if (in->beam) {
+                ALOGI("reading the microphone array: the speaker is removed while it plays");
+            }
+        }
+        /* Off, or the array would not open: the Fire OS HAL until standby. */
+        if (!in->beam) in->beam_off = true;
+    }
+    if (in->beam) {
+        ssize_t frames = mic_beam_read(in->beam, buffer, bytes / sizeof(int16_t));
+        if (frames < 0) {
+            in_close_beam(in);
+            in->beam_off = true;
+            memset(buffer, 0, bytes);
+            return bytes;
+        }
+        if (in->adev->mic_muted) memset(buffer, 0, bytes);
+        in->beam_frames += frames;
+        return bytes;
+    }
+    return in->amazon_stream->read(in->amazon_stream, buffer, bytes);
+}
+
+static uint32_t in_get_input_frames_lost(struct audio_stream_in* stream) {
+    struct wrapper_stream_in* in = wrap_in(stream);
