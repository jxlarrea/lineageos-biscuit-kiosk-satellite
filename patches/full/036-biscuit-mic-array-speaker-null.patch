+    if (in->beam) {
+        struct timespec now;
+        if (!frames || !time) return -EINVAL;
+        clock_gettime(CLOCK_MONOTONIC, &now);
+        *frames = (int64_t)in->beam_frames;
+        *time = now.tv_sec * 1000000000LL + now.tv_nsec;
+        return 0;
+    }
+    if (!in->amazon_stream->get_capture_position) return -ENOSYS;
+    return in->amazon_stream->get_capture_position(in->amazon_stream, frames, time);
+}
