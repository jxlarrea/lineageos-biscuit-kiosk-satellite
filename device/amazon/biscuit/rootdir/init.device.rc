# Amazon's audio HAL toggles Biscuit microphone privacy through GPIO87.
on boot
    chown root audio /sys/devices/soc/1000b000.pinctrl/mt_gpio
    chmod 0664 /sys/devices/soc/1000b000.pinctrl/mt_gpio
    # sensors.mt8163 (system_server) powers the TSL2540 ambient light sensor.
    chown system system /sys/bus/i2c/devices/0-0039/als_power_state

service audio_init /system/bin/sh /system/etc/audio_init.sh
    class late_start
    user root
    group root
    oneshot

on property:sys.boot_completed=1
    start biscuit-ledd

service biscuit-ledd /system/bin/biscuit-ledd
    class main
    user root
    group system
    socket biscuit-ledd stream 0660 system system
    disabled
