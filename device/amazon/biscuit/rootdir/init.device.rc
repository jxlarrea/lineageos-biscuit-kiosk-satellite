# Amazon's audio HAL toggles Biscuit microphone privacy through GPIO87.
on boot
    chown root audio /sys/devices/soc/1000b000.pinctrl/mt_gpio
    chmod 0664 /sys/devices/soc/1000b000.pinctrl/mt_gpio
    # sensors.mt8163 (system_server) powers the TSL2540 ambient light sensor.
    chown system system /sys/bus/i2c/devices/0-0039/als_power_state

service audio_init /system/bin/sh /system/etc/audio_init.sh
    class late_start
    user root
    group root
    oneshot

on property:sys.boot_completed=1
    start biscuit-ledd
    start ks_install
    # The perf profiling daemon only collects for Google's internal builds.
    stop perfprofd
    # All four cores stay online. MediaTek's hotplug daemon parked and
    # unparked them every second or two at idle, which saves next to nothing
    # on a device that is always plugged in, and an app reading the cores'
    # idle counters counted the parked time as busy.
    write /proc/hps/enabled 0
    write /sys/devices/system/cpu/cpu1/online 1
    write /sys/devices/system/cpu/cpu2/online 1
    write /sys/devices/system/cpu/cpu3/online 1

# Kiosk Satellite Edition: installs Kiosk Satellite on first boot and keeps its
# grants in place. setprop persist.biscuit.ks_install 0 turns it off.
service ks_install /system/bin/sh /system/etc/ks-install.sh
    class late_start
    user root
    group root
    disabled
    oneshot

service biscuit-ledd /system/bin/biscuit-ledd
    class main
    user root
    group system
    socket biscuit-ledd stream 0660 system system
    disabled
